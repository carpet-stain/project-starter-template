# TypeScript overlay verbs — picked up by the base justfile's `import?`. Base
# verbs (lint, adr) live in justfile.base; never add them here.

# Run the test suite.
test *args:
    pnpm run test {{ args }}

# Type-check the project (vitest/tsx never do — tsc is the only checker).
typecheck:
    pnpm exec tsc --noEmit

# The base's `format` verb owns markdown; a duplicate recipe name hard-errors.
# Format TypeScript sources with Biome.
fmt:
    pnpm run format
